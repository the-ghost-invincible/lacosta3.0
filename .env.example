# PostgreSQL connection
DATABASE_URL=postgres://lacosta:CHANGE_ME@localhost:5432/lacosta

# Resend API key (get from https://resend.com)
RESEND_API_KEY=re_xxxxx

# Email sender address
EMAIL_FROM=Lacosta <noreply@yourdomain.com>

# Public base URL for email links (no trailing slash)
BASE_URL=http://localhost:4000

# Admin panel
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_PATH=/admin-7f3k9
ADMIN_EMAIL=your@email.com
PORT=4000

# Lipana (M-Pesa via lipana.dev) — credentials are per-university in the admin panel
# No global env keys needed. Configure each university's Lipana keys in the admin Payments tab.

# Error tracking (optional — get from https://sentry.io)
SENTRY_DSN=